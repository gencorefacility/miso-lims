#!/bin/bash

# Exit immediately if any command fails
set -e

echo "=========================================="
echo " Starting MISO LIMS Podman Upgrade Script"
echo "=========================================="

# 1. Load the exact environment variables
set_env() {
    export YML="/root/miso-lims/nyu.plain.yml"
    export COMPOSE_CMD="podman-compose -f ${YML}"
    export MISO_DB_USER=tgaclims
    export MISO_DB=lims
    export MISO_DB_PASSWORD_FILE=/root/bin/.miso_db_password
    export MISO_DB_ROOT_PASSWORD_FILE=/root/bin/.miso_root_password
    export MISO_TAG=latest
    echo "    [OK] Environment variables loaded."
}

echo ""
echo "--> Initializing environment..."
set_env

# 2. Setup the backup directory
BACKUP_DIR="$HOME/backup"
mkdir -p "$BACKUP_DIR"
echo "    [OK] Backup directory set to $BACKUP_DIR"

echo ""
echo "--> Step 1: Backing up the MySQL database..."
DB_BACKUP_FILE="$BACKUP_DIR/miso_db_backup_$(date +%F_%H-%M-%S).sql"

# Read the password on the host and strip any hidden newlines
ROOT_PASS=$(cat "$MISO_DB_ROOT_PASSWORD_FILE" | tr -d '\n')

# Execute the dump directly against the known container name using the variables
podman exec -i miso-lims_db_1 mysqldump -u root -p"$ROOT_PASS" "$MISO_DB" > "$DB_BACKUP_FILE"

# Failsafe: Abort if the backup file is empty
if [ ! -s "$DB_BACKUP_FILE" ]; then
    echo "ERROR: Backup file is empty! Aborting upgrade to protect your data."
    rm -f "$DB_BACKUP_FILE"
    exit 1
fi
echo "    [OK] Database successfully backed up to $DB_BACKUP_FILE"

echo ""
echo "--> Step 2: Backing up local files and database directories..."
DIR_BACKUP_FILE="$BACKUP_DIR/miso_dir_backup_$(date +%F_%H-%M-%S).tar.gz"
tar -czvf "$DIR_BACKUP_FILE" /miso/files /miso/db > /dev/null 2>&1
echo "    [OK] Directories /miso/files and /miso/db backed up to $DIR_BACKUP_FILE"

echo ""
echo "--> Step 3: Updating local source code..."
git fetch --all --tags
git checkout "$MISO_TAG"
git pull origin "$MISO_TAG" || true 

echo ""
echo "--> Step 4: Pulling latest base images..."
${COMPOSE_CMD} pull

echo ""
echo "--> Step 5: Rebuilding local images from scratch (no cache)..."
${COMPOSE_CMD} build --no-cache

echo ""
echo "--> Step 6: Shutting down the current LIMS stack..."
${COMPOSE_CMD} down

echo ""
echo "--> Step 7: Bringing the upgraded LIMS stack online..."
${COMPOSE_CMD} up -d

echo ""
echo "--> Step 8: Cleaning up old dangling Podman layers..."
podman image prune -f

echo ""
echo "=========================================="
echo " Upgrade Complete!"
echo " The backups are safely stored in $BACKUP_DIR"
echo " The 'flyway' container is now migrating the database."
echo " Check progress with: podman logs -f miso-lims_flyway_1"
echo "=========================================="
